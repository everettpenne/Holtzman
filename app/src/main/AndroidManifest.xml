<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Holtzman asks for the camera and nothing else. There is no INTERNET permission, no location, no storage permission (photos are written
      through MediaStore, which needs none), and the microphone only for video, asked for the first time you record.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Asked for in context, the first time video is recorded; a refusal records without sound. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <!-- Whether Sietch is installed, to offer "Show in Sietch" (nothing else about other apps is visible to Holtzman). -->
    <queries>
        <!-- the Pixel Camera app, for paired data collection (a photo of the same moment as a dataset series) -->
        <package android:name="com.google.android.GoogleCamera" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="sietch" />
        </intent>
    </queries>

    <application
        android:largeHeap="true"
        android:label="Holtzman"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:description="@string/app_description"
        android:category="image"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Holtzman">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- What a gallery's, a launcher's or the lock screen's camera button sends: just open the camera. -->
            <intent-filter>
                <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
                <action android:name="android.media.action.VIDEO_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          The camera opened while the phone is locked (the double press of the power button, the lock screen's camera button): a separate activity, so it alone shows over
          the lock screen; the main one never does, so locking the phone with Holtzman open shows the lock screen as usual. It shows none of the photos already on the phone
          (only what is shot in it), shares nothing, opens no other app, and closes when it leaves the screen.
        -->
        <activity
            android:name=".SecureCameraActivity"
            android:exported="true"
            android:showWhenLocked="true"
            android:excludeFromRecents="true"
            android:taskAffinity="com.everettpenne.holtzman.secure"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.media.action.STILL_IMAGE_CAMERA_SECURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The suite's capture contract: another app asks for one photo or video and gets it back (see CaptureContract). -->
        <activity
            android:name=".CaptureActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="com.everettpenne.holtzman.action.CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Android's own requests for one picture or video, from any app that wants a shot (a gallery's "take a photo", a form's photo field). -->
            <intent-filter>
                <action android:name="android.media.action.IMAGE_CAPTURE" />
                <action android:name="android.media.action.VIDEO_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
